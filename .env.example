# Firebase (client SDK config — not secret, safe to be public; see
# https://firebase.google.com/docs/projects/api-keys)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI provider keys — SERVER-SIDE ONLY. Do not prefix with VITE_, or Vite
# will inline them into the client bundle. These are read by the
# functions in api/, not by the frontend.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Seed script only (npm run seed). SEED_USER_PASSWORD is shared by every
# seeded volunteer and organization account; SEED_ADMIN_PASSWORD is used to
# sign in as admin@athar.gov for the verification pass.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
